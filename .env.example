# Garmin Connect (for the poller)
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password
GARMIN_TOKEN_DIR=~/.garminconnect

# Telegram (for alerts)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...
TELEGRAM_CHAT_ID=987654321

# Storage
DB_PATH=./garmin.db

# Alert thresholds
HR_RESTING_HIGH_BPM=85
ALERT_COOLDOWN_SECONDS=300

# Poller cadence (the systemd timer also enforces this)
POLL_INTERVAL_MINUTES=15

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Biometrics (used for BMR, step kcal, energy availability, HR-zone math)
USER_AGE=30
USER_HEIGHT_CM=175
USER_WEIGHT_KG=75
USER_SEX=male           # 'male' or 'female'

# Nutrition + training targets
PROTEIN_TARGET_G_PER_KG=1.6     # 1.2 sedentary · 1.6 active · 2.0 hard training
KCAL_TARGET=2200                # daily kcal target (drives fiber target = 14×kcal/1000)
SLEEP_TARGET_HOURS=8
USER_HRMAX=0                    # leave 0 to use 220 - age
